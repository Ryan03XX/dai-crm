rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function canEditDeal(dealId) {
      let deal = firestore.get(/databases/(default)/documents/deals/$(dealId)).data;
      return signedIn() && (deal.ownerId == request.auth.uid || deal.picId == request.auth.uid);
    }

    match /opportunities/{dealId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.size < 10 * 1024 * 1024
        && (isAdmin() || canEditDeal(dealId));
      allow delete: if isAdmin() || canEditDeal(dealId);
    }

    match /{allPaths=**} {
      allow read: if signedIn();
    }
  }
}
